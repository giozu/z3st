#!/bin/bash
cd "${0%/*}" || exit 1  # Run from this directory

echo "🧹 Cleaning Zest working directory..."

# ----------------------
# Log and output files
# ----------------------
rm -f log.*

# ----------------------
# ParaView / VTK files
# ----------------------
rm -f *.h5
rm -f *.xdmf
rm -f *.xdmf.index
rm -f *.vtu
rm -f *.pvtu
rm -f *.pvd
rm -f *.btr

# ----------------------
# Zest stiffness matrix exports
# ----------------------
rm -f stiffness_matrix.txt
rm -f mech_stiffness_matrix.txt
rm -f thermal_stiffness_matrix.txt

# ----------------------
# Images
# ----------------------
rm -f *.png

# ----------------------
# Output folders and step results
# ----------------------
find output -type d -name "step_*" -exec rm -r {} +
rm -f output/*.xdmf
rm -f output/*.h5
rm -f output/*.csv
rm -f output/*.log
rm -f output/*.txt
rm -f output/*.png
rm -f output/*.xdmf.index

# ----------------------
# Python __pycache__ folders
# ----------------------
find . -type d -name "__pycache__" -exec rm -rf {} +

echo "✅ Done. All output and temporary files cleaned."
