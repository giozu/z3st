#!/bin/bash
# --.. ..- .-.. .-.. --- --.. ..- .-.. .-.. --- --.. ..- .-.. .-.. ---
# Z3ST: An open-source FEniCSx framework for thermo-mechanical analysis
# Author: Bianca Funaro
# Version: 0.4.1 (2026)
# --.. ..- .-.. .-.. --- --.. ..- .-.. .-.. --- --.. ..- .-.. .-.. ---
#
#     ./Allpost      post-process every subfolder with a post.yaml, at any depth
#                    (hex_post.py), compare IAEA VP1 z_uniform with Ansys
#                    (bowing/corner-corner/IAEA/VP1/compare_ansys.py), draw the
#                    legend of the components (results_components.py) and group
#                    results/ by problem (results_organize.py). The 1515Ti_Tdependent
#                    sets are post-processed only together with the constant card
#                    (compare_const*.py, compare_alpha_E.py for the separate effects
#                    of alpha(T) and E(T)) and with Ansys when ANSYS_1515TI is set, in
#                    results/bowing_corner-corner_IAEA_VP1/1515Ti_Tdep/; the stress
#                    peaks of the 3D runs are catalogued in results/peaks/
#                    (peaks_catalogue.py)
#
# Reads only the existing outputs: run the cases first. A subfolder with no
# output is skipped. Every figure and summary goes to results/, first named
# after its subfolder (<subfolder>_<figure>.png, IAEA_VP1_<option>_vs_Ansys_<figure>),
# then moved to results/<problem>/ as <figure>.png (the folder names the case).

set -e
cd "${0%/*}" || exit 1
export HDF5_USE_FILE_LOCKING=FALSE

find . -name post.yaml -not -path '*/output/*' -not -path '*/1515Ti_Tdependent/*' | sort | while read -r post; do
    python3 hex_post.py "$(dirname "$post")"
done
python3 bowing/corner-corner/IAEA/VP1/compare_ansys.py
VP1=bowing/corner-corner/IAEA/VP1
python3 $VP1/1515Ti_Tdependent/compare_const.py
python3 $VP1/1515Ti_Tdependent/compare_const_corners.py
python3 $VP1/1515Ti_Tdependent/compare_alpha_E.py   # needs alpha_only/ and E_only/ run
A=${ANSYS_1515TI:-}   # folder with Sobolev/ and DiMarcello/ Ansys exports
for law in Sobolev DiMarcello; do
    case=$VP1/1515Ti_Tdependent; [ "$law" = DiMarcello ] && case=$case/DiMarcello
    if [ -n "$A" ] && [ -f "$A/$law/vp1_ansys_nodes.txt" ]; then
        python3 $VP1/compare_ansys.py --case "$case" --ansys "$A/$law"
    else
        echo "SKIP: no Ansys export in \${ANSYS_1515TI}/$law"
    fi
done
python3 results_components.py
python3 peaks_catalogue.py
python3 results_organize.py
