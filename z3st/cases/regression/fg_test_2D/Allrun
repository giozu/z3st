#!/bin/bash
cd "${0%/*}" || exit 1

set -e

# SCIANTIX coupling (models.fission_gas) needs a -DCOUPLING_TU *shared* library.
# No default is invented here. If SCIANTIX_LIB is unset the binding falls back
# to the loader's search for "libsciantix.so" (a system install).
if [ -n "${SCIANTIX_LIB:-}" ] && [ ! -f "$SCIANTIX_LIB" ]; then
  echo "[Allrun] ERROR: SCIANTIX_LIB='$SCIANTIX_LIB' does not exist." >&2
  echo "        Build it as described in z3st/coupling/sciantix/README.md, section 1." >&2
  echo "        Note -DCOUPLING_TU is required: without it the library still loads" >&2
  echo "        and runs, but SCIANTIX computes its own burnup and ignores Z3ST's." >&2
  exit 1
elif [ -z "${SCIANTIX_LIB:-}" ]; then
  echo "[Allrun] SCIANTIX_LIB unset; relying on the loader to find libsciantix.so."
fi

echo "Executing z3st..."
gmsh mesh.geo -2 > log_mesh.md
start=$SECONDS
Z3ST_PLAIN_LOG=1 python3 -m z3st > log_z3st.md
echo "z3st solve completed in $((SECONDS - start)) s  (solver log: log_z3st.md)"
python3 non-regression.py
python3 plots.py
